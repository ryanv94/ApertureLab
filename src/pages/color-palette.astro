---
import Base from '../layouts/Base.astro';
import ToolHeader from '../components/ToolHeader.astro';
import DropZone from '../components/DropZone.astro';
import Slider from '../components/Slider.astro';
import ErrorBox from '../components/ErrorBox.astro';
import { tools } from '../data/tools';
const t = tools.find((x) => x.slug === 'color-palette')!;
---
<Base title={t.name} description="Extract the dominant colour palette from a photo and read its RGB and luminance histograms. Export as PNG, CSS or JSON. Runs in your browser." slug={t.slug}>
  <ToolHeader frame={t.frame} name={t.name} lede="Pull out a photo’s dominant colours, ordered by how much of the frame each covers. Click a swatch to copy its hex code." />
  <div class="panel-grid develop">
    <section class="panel sticky" aria-label="Palette settings">
      <DropZone id="drop" label="Drop a photo" />
      <ErrorBox id="err" />
      <div class="field">
        <label class="label" for="k"><span>Colours</span><output id="k-out" for="k">6</output></label>
        <input type="range" id="k" min="3" max="10" step="1" value="6" />
      </div>
      <div>
        <p class="panel-title">RGB histogram</p>
        <canvas id="hist-rgb" class="hist"></canvas>
        <p class="panel-title" style="margin-top:14px">Luminance</p>
        <canvas id="hist-l" class="hist"></canvas>
        <div class="axis" aria-hidden="true"><span>Shadows</span><span>Highlights</span></div>
      </div>
      <div id="exports" class="exports" hidden>
        <button type="button" class="btn" id="dl-png">PNG strip</button>
        <button type="button" class="btn" id="copy-css">Copy CSS</button>
        <button type="button" class="btn" id="dl-json">JSON</button>
      </div>
      <input type="text" id="copy-fallback" readonly hidden aria-label="Text to copy" />
    </section>
    <section class="out" aria-label="Palette">
      <div class="stage">
        <canvas id="preview" hidden></canvas>
        <p id="empty" class="stage-empty">Your photo and its palette appear here.</p>
      </div>
      <p id="status" class="hint" aria-live="polite"></p>
      <div id="swatches" class="swatches"></div>
    </section>
  </div>
  <script>import '../tools/palette/ui';</script>
</Base>
<style>
  .hist { width: 100%; height: 90px; margin-top: 8px; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); }
  .axis { display: flex; justify-content: space-between; font-size: 10px; color: var(--text-dim); margin-top: 4px; }
  .exports { display: flex; flex-wrap: wrap; gap: 8px; }
  .out { display: grid; gap: 14px; min-width: 0; }
  .swatches { display: flex; flex-wrap: wrap; gap: 6px; }
  .swatches :global(.swatch) {
    flex: 1 1 110px; min-width: 110px; display: grid; gap: 4px; padding: 0 0 10px; text-align: left;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); cursor: pointer; overflow: hidden;
    transition: transform .15s var(--ease), border-color .15s;
  }
  .swatches :global(.swatch:hover) { transform: translateY(-3px); border-color: var(--text-dim); }
  .swatches :global(.chip) { height: 96px; background: var(--c); margin-bottom: 6px; }
  .swatches :global(.hex) { font: 500 18px/1 var(--font-display); padding-inline: 10px; }
  .swatches :global(.rgb), .swatches :global(.share) { font-size: 11px; color: var(--text-dim); padding-inline: 10px; }
  .swatches :global(.share) { color: var(--amber); }
</style>
