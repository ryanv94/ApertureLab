---
import Base from '../layouts/Base.astro';
import ToolHeader from '../components/ToolHeader.astro';
import { tools } from '../data/tools';
const t = tools.find((x) => x.slug === 'resize-watermark')!;
---
<Base title={t.name} description={t.blurb} slug={t.slug}>
  <ToolHeader frame={t.frame} name={t.name} lede={t.blurb} />
</Base>
