---
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<dialog class="modal" id={id} aria-labelledby={`${id}-title`}>
  <div class="modal-head">
    <h2 id={`${id}-title`}>{title}</h2>
    <button type="button" class="modal-close" aria-label="Close" onclick="this.closest('dialog').close()">✕</button>
  </div>
  <div class="modal-body"><slot /></div>
  <slot name="footer" />
</dialog>
