---
// Empty preview state: a faint line-art ghost of what the tool will produce, plus one sentence.
// `id="empty"` is toggled by each tool's ui.ts (`hidden`).
interface Props { id?: string; kind: 'frame' | 'resize' | 'print' | 'light' | 'pano' | 'palette'; stage?: boolean }
const { id = 'empty', kind, stage = false } = Astro.props;
---
<div id={id} class:list={['stage-empty', 'ghost', { stage }]}>
  <svg viewBox="0 0 160 100" width="160" height="100" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
    {kind === 'frame' && (<>
      <rect x="20" y="8" width="120" height="84" />
      <rect x="28" y="16" width="104" height="60" stroke-dasharray="3 3" />
      <path d="M28 84h28M104 84h14M124 84h8" />
      <circle cx="98" cy="84" r="1.6" class="hot" fill="currentColor" stroke="none" />
    </>)}
    {kind === 'resize' && (<>
      <rect x="14" y="16" width="86" height="68" />
      <rect x="40" y="30" width="106" height="56" stroke-dasharray="3 3" class="hot" />
      <path d="M40 24v6h-6M146 24v6h6" />
    </>)}
    {kind === 'print' && (<>
      <rect x="10" y="10" width="140" height="80" />
      <path d="M10 28h140M10 46h140M10 64h140M10 82h140M96 10v80M122 10v80" />
      <rect x="10" y="46" width="140" height="18" class="hot" />
    </>)}
    {kind === 'light' && (<>
      <path d="M12 74h136" />
      <path d="M52 74a28 28 0 0 1 56 0" class="hot" />
      <path d="M80 30v8M50 40l5 6M110 40l-5 6M36 58l8 2M124 58l-8 2" />
      <path d="M12 90h136" stroke-dasharray="2 5" />
      <path d="M30 86v8M60 86v8M90 86v8M120 86v8" />
    </>)}
    {kind === 'pano' && (<>
      <rect x="8" y="24" width="44" height="52" />
      <rect x="58" y="24" width="44" height="52" />
      <rect x="108" y="24" width="44" height="52" class="hot" />
      <path d="M8 56l14-14 12 10 18-16M58 56l14-14 12 10 18-16M108 56l14-14 12 10 18-16" />
    </>)}
    {kind === 'palette' && (<>
      <rect x="14" y="10" width="132" height="48" />
      <path d="M14 46l32-22 26 18 24-12 50 16" />
      <rect x="14" y="68" width="22" height="22" />
      <rect x="42" y="68" width="22" height="22" />
      <rect x="70" y="68" width="22" height="22" class="hot" />
      <rect x="98" y="68" width="22" height="22" />
      <rect x="126" y="68" width="20" height="22" />
    </>)}
  </svg>
  <p><slot /></p>
</div>
<style>
  .ghost { display: grid; justify-items: center; gap: 16px; align-content: center; }
  svg { color: color-mix(in srgb, var(--line), var(--text-dim) 30%); }
  svg :global(.hot) { stroke: var(--accent); opacity: .7; }
  p { max-width: 36ch; }
</style>
