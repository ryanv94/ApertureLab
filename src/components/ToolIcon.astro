---
interface Props { slug: string }
const { slug } = Astro.props;
---
<svg viewBox="0 0 64 40" width="96" height="60" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true" class="tool-icon">
  {slug === 'dof-visualizer' && <>
    <path d="M4 20h56" stroke-dasharray="2 3" opacity=".5" />
    <rect x="24" y="8" width="20" height="24" fill="var(--amber)" fill-opacity=".14" stroke="var(--amber)" />
    <path d="M4 16l4 4-4 4" /><circle cx="32" cy="20" r="3" fill="var(--accent)" stroke="none" />
  </>}
  {slug === 'exposure-calculator' && <>
    <circle cx="32" cy="20" r="15" /><path d="M32 20l8-8" stroke="var(--accent)" stroke-width="1.6" />
    {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <path d={`M${32 + 15 * Math.cos(i * Math.PI / 4)} ${20 + 15 * Math.sin(i * Math.PI / 4)}l${-3 * Math.cos(i * Math.PI / 4)} ${-3 * Math.sin(i * Math.PI / 4)}`} />)}
    <rect x="48" y="6" width="10" height="28" fill="currentColor" fill-opacity=".25" />
  </>}
  {slug === 'resize-watermark' && <>
    <rect x="8" y="6" width="34" height="26" /><rect x="22" y="14" width="34" height="22" stroke="var(--accent)" stroke-dasharray="3 2" />
    <text x="50" y="32" font-size="5" fill="currentColor" stroke="none" text-anchor="end" font-family="var(--font-mono)">©</text>
  </>}
  {slug === 'exif-frame' && <>
    <rect x="12" y="2" width="40" height="36" /><rect x="16" y="6" width="32" height="22" fill="currentColor" fill-opacity=".18" />
    <path d="M16 33h12M38 33h10" stroke-width="1.6" /><circle cx="16" cy="33" r=".1" stroke="var(--accent)" stroke-width="3" />
  </>}
  {slug === 'panorama-splitter' && <>
    <path d="M2 28l12-10 10 7 12-12 14 10 12-6" /><rect x="2" y="6" width="60" height="28" />
    <path d="M22 6v28M42 6v28" stroke="var(--accent)" stroke-dasharray="2 2" />
  </>}
  {slug === 'color-palette' && <>
    {['var(--accent)', 'var(--amber)', '#8FBF6A', '#2B4C8C', 'currentColor'].map((c, i) => <rect x={6 + i * 11} y="8" width="9" height="16" fill={c} fill-opacity={c === 'currentColor' ? .5 : .9} stroke="none" />)}
    <path d="M6 34c6-8 10-2 16-6s8-4 14 0 12 2 22-4" />
  </>}
  {slug === 'golden-hour' && <>
    <path d="M4 30h56" /><path d="M18 30a14 14 0 0 1 28 0" stroke="var(--amber)" />
    <path d="M32 8v4M14 14l3 3M50 14l-3 3" /><path d="M4 36h56" stroke="#2B4C8C" stroke-width="2" />
  </>}
  {slug === 'print-visualizer' && <>
    <rect x="6" y="4" width="22" height="32" /><rect x="34" y="12" width="14" height="24" /><rect x="52" y="22" width="8" height="14" />
    <path d="M6 4l22 32" stroke="var(--accent)" opacity=".7" />
  </>}
  {slug === 'selphy-layout' && <>
    <rect x="4" y="4" width="56" height="32" /><rect x="14" y="8" width="14" height="24" fill="currentColor" fill-opacity=".18" /><rect x="36" y="8" width="14" height="24" fill="currentColor" fill-opacity=".18" />
    <path d="M10 8h2M14 4v2M30 32h2M28 36v-2M32 8h2M36 4v2M54 32h-2M50 36v-2" stroke="var(--accent)" />
  </>}
  {slug === 'collage' && <>
    <rect x="4" y="4" width="56" height="32" />
    <rect x="8" y="8" width="24" height="24" fill="currentColor" fill-opacity=".18" />
    <rect x="36" y="8" width="20" height="11" fill="currentColor" fill-opacity=".18" />
    <rect x="36" y="23" width="9" height="9" fill="currentColor" fill-opacity=".18" /><rect x="48" y="23" width="8" height="9" stroke="var(--accent)" />
  </>}
</svg>
