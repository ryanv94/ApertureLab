---
import type { ToolMeta } from '../data/tools';
import ToolIcon from './ToolIcon.astro';
interface Props { tool: ToolMeta }
const { tool } = Astro.props;
---
<a class="tool-frame" href={`${tool.slug}.html`}>
  <span class="num" aria-hidden="true">{tool.frame}</span>
  <span class="art"><ToolIcon slug={tool.slug} /></span>
  <span class="name">{tool.name}</span>
  <span class="blurb">{tool.blurb}</span>
</a>
<style>
  .tool-frame {
    position: relative; display: grid; grid-template-rows: auto 1fr auto auto; gap: 8px;
    padding: 16px 18px 22px; min-height: 230px; text-decoration: none; overflow: hidden;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    transition: background .2s, border-color .2s;
  }
  .num { font: 300 40px/1 var(--font-display); color: var(--fjord); font-variant-numeric: tabular-nums; }
  .art { display: grid; place-items: center; padding: 10px 0; color: var(--text-dim); transition: color .2s; }
  .name { font: 500 20px/1.2 var(--font-display); }
  .blurb { font: 400 13px/1.5 var(--font-body); color: var(--text-dim); }
  .tool-frame::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--accent);
    transform: scaleX(0); transform-origin: left;
  }
  .tool-frame:hover, .tool-frame:focus-visible { background: var(--surface-2); border-color: var(--accent); outline: none; }
  .tool-frame:hover .art, .tool-frame:focus-visible .art { color: var(--text); }
  .tool-frame:hover::after, .tool-frame:focus-visible::after { transform: scaleX(1); }
  @media (prefers-reduced-motion: no-preference) { .tool-frame::after { transition: transform .35s var(--ease); } }
</style>
