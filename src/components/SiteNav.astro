---
import { tools } from '../data/tools';
import ApertureMark from './ApertureMark.astro';
interface Props { slug?: string }
const { slug } = Astro.props;
---
<header class="site-header">
  <div class="wrap bar">
    <a href="index.html" class="wordmark" aria-label="ApertureLab home">
      <ApertureMark />
      <span>Aperture<em>Lab</em></span>
    </a>
    <nav class="desktop" aria-label="Tools">
      {tools.map((t) => (
        <a href={`${t.slug}.html`} aria-current={t.slug === slug ? 'page' : undefined} title={t.name}>
          <span class="num">{t.frame}</span>{t.short}
        </a>
      ))}
    </nav>
    <button class="menu-btn" type="button" aria-controls="site-menu" aria-expanded="false">
      <span class="visually-hidden">Open tool menu</span>
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 7h16M3 15h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" /></svg>
    </button>
  </div>
</header>

<dialog id="site-menu" aria-label="Tools">
  <div class="menu-head">
    <a href="index.html" class="wordmark"><ApertureMark /><span>Aperture<em>Lab</em></span></a>
    <button type="button" class="menu-close" aria-label="Close menu">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
  </div>
  <nav aria-label="Tools" class="sheet">
    {tools.map((t, i) => (
      <a href={`${t.slug}.html`} aria-current={t.slug === slug ? 'page' : undefined} class="sheet-frame" style={`--n:${i}`}>
        <span class="edge">▸ {t.frame}A</span>
        <span class="name">{t.name}</span>
      </a>
    ))}
  </nav>
</dialog>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const menu = document.getElementById('site-menu') as HTMLDialogElement;
  btn.addEventListener('click', () => { menu.showModal(); btn.setAttribute('aria-expanded', 'true'); });
  menu.querySelector('.menu-close')!.addEventListener('click', () => menu.close());
  menu.addEventListener('close', () => { btn.setAttribute('aria-expanded', 'false'); btn.focus(); });
  menu.addEventListener('click', (e) => { if (e.target === menu) menu.close(); });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgb(18 16 14 / .88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 60px; gap: 24px; }
  .wordmark {
    display: inline-flex; align-items: center; gap: 10px; text-decoration: none;
    font: 500 21px/1 var(--font-display); font-variation-settings: 'opsz' 48, 'SOFT' 0; letter-spacing: -.01em;
  }
  .wordmark em { font-style: italic; color: var(--accent); font-variation-settings: 'opsz' 48, 'SOFT' 100; }
  .wordmark :global(.mark) { color: var(--text); transition: transform .6s var(--ease); }
  .wordmark:hover :global(.mark) { transform: rotate(60deg); }

  .desktop { display: none; gap: 2px; }
  .desktop a {
    position: relative; text-decoration: none; font-size: 12px; letter-spacing: .02em;
    padding: 8px 10px; color: var(--text-dim); border-radius: var(--radius); white-space: nowrap;
    transition: color .2s, background .2s;
  }
  .desktop .num { font-size: 9px; vertical-align: super; margin-right: 3px; color: var(--line); transition: color .2s; }
  .desktop a:hover { color: var(--text); background: var(--surface); }
  .desktop a:hover .num { color: var(--accent); }
  .desktop a[aria-current='page'] { color: var(--text); }
  .desktop a[aria-current='page'] .num { color: var(--accent); }
  .desktop a[aria-current='page']::after {
    content: ''; position: absolute; left: 10px; right: 10px; bottom: -11px; height: 2px; background: var(--accent);
  }

  .menu-btn, .menu-close {
    display: grid; place-items: center; width: 40px; height: 40px;
    background: transparent; border: 1px solid var(--line); border-radius: var(--radius); cursor: pointer;
  }
  @media (min-width: 1100px) {
    .desktop { display: flex; }
    .menu-btn { display: none; }
  }

  dialog {
    width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: var(--gutter);
    background: var(--bg); color: var(--text); border: 0;
  }
  dialog::backdrop { background: rgb(0 0 0 / .6); }
  .menu-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; }
  .sheet { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }
  .sheet-frame {
    display: flex; flex-direction: column; justify-content: space-between; gap: 18px;
    aspect-ratio: 3 / 2; padding: 12px; text-decoration: none;
    background: var(--surface); border: 1px solid var(--line); border-radius: 2px;
  }
  .sheet-frame .edge { font-size: 10px; color: var(--accent); letter-spacing: .1em; }
  .sheet-frame .name { font: 500 18px/1.1 var(--font-display); }
  .sheet-frame[aria-current='page'] { border-color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    dialog[open] .sheet-frame { animation: develop .6s var(--ease) both; animation-delay: calc(var(--n, 0) * 40ms); }
  }
</style>
